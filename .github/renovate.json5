{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Dependabot already bumps actions
  "github-actions": {
    "enabled": false,
  },

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/ublue-os/bazzite", "ghcr.io/ublue-os/bazzite-nvidia-open", "ghcr.io/ublue-os/bazzite-nvidia"],
      "automerge": false,
      "addLabels": ["base-image"],
      "commitMessageTopic": "Bazzite base image",
      "schedule": ["before 6am on monday"],
    },
  ]
}
